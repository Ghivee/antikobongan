# Environment Variables

# ESP32 Configuration
ESP32_BAUD_RATE=9600
ESP32_BLE_DEVICE_NAME="AntiKobongan"

# Application Configuration
APP_NAME="AntiKobongan"
APP_VERSION="1.0.0"

# Bundler Configuration (Metro bundler for React Native)
METRO_PORT=8081
BUNDLE_OUTPUT_DIR=build
BUNDLE_PLATFORM=android

# Development
DEBUG=false
LOG_LEVEL=info