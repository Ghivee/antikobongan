# Salin ke backend/.env lalu isi nilai asli. Jangan commit backend/.env.
# File ini juga dibaca server.js saat dasbor dijalankan lokal.

# ── Broker MQTT untuk backend (pencatat) ────────────────────────────────────
# Default: broker publik HiveMQ (tanpa login). Untuk broker privat
# (HiveMQ Cloud / EMQX) isi MQTT_USERNAME/MQTT_PASSWORD dan MQTT_TLS=1.
MQTT_HOST=broker.hivemq.com
MQTT_PORT=1883
MQTT_TLS=0
MQTT_USERNAME=
MQTT_PASSWORD=
TOPIC_PREFIX=antikobongan/prototipe-gx7q4m
NODE_ID=esp32-01

# ── Broker MQTT untuk dasbor (browser, WebSocket) ───────────────────────────
# Dikirim ke browser lewat /api/mqtt-config. Pakai akun yang HANYA boleh
# subscribe. Kosongkan untuk broker publik.
MQTT_WS_URL=wss://broker.hivemq.com:8884/mqtt
MQTT_WEB_USERNAME=
MQTT_WEB_PASSWORD=

# ── Supabase (server-side saja, jangan pernah ke frontend) ──────────────────
SUPABASE_URL=https://GANTI-PROJECT.supabase.co
SUPABASE_SECRET_KEY=GANTI_SERVICE_ROLE_KEY

# ── Telegram opsional; kosongkan bila belum dipakai ─────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Deteksi node offline dan retensi ────────────────────────────────────────
STALE_SECONDS=30
RETENTION_DAYS=90

# ── Ambang alert dan cooldown (detik) ───────────────────────────────────────
ALERT_RISK_HIGH=60
ALERT_RISK_CRITICAL=80
ALERT_COOLDOWN_SECONDS=300

# ── Admin dasbor ────────────────────────────────────────────────────────────
# PIN membuka form konfigurasi node (disimpan ke tabel nodes di Supabase).
ADMIN_PIN=GANTI_PIN_6_ANGKA
# Rahasia acak panjang untuk menandatangani token sesi admin.
# Buat dengan: openssl rand -hex 32
ADMIN_TOKEN_SECRET=GANTI_DENGAN_HEX_ACAK
